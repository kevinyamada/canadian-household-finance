      {
        "name": "PurchaseCases",
        "columns": [
          {
            "name": "home_price",
            "dataType": "int64",
            "sourceColumn": "home_price",
            "summarizeBy": "none",
            "formatString": "\"CAD \"#,0;(\"CAD \"#,0)"
          },
          {
            "name": "home_price_label",
            "dataType": "string",
            "sourceColumn": "home_price_label",
            "summarizeBy": "none",
            "sortByColumn": "home_price"
          },
          {
            "name": "closing_allowance_pct",
            "dataType": "double",
            "sourceColumn": "closing_allowance_pct",
            "summarizeBy": "none"
          },
          {
            "name": "closing_allowance_label",
            "dataType": "string",
            "sourceColumn": "closing_allowance_label",
            "summarizeBy": "none",
            "sortByColumn": "closing_allowance_pct"
          },
          {
            "name": "minimum_down_payment",
            "dataType": "double",
            "sourceColumn": "minimum_down_payment",
            "summarizeBy": "none",
            "formatString": "\"CAD \"#,0;(\"CAD \"#,0)"
          },
          {
            "name": "closing_allowance",
            "dataType": "double",
            "sourceColumn": "closing_allowance",
            "summarizeBy": "none",

            "dataType": "string",
            "sourceColumn": "scope",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "PurchaseCases",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Table.FromRecords(Json.Document(Binary.FromText(\"\", BinaryEncoding.Base64))),",
                "    Typed = Table.TransformColumnTypes(Source, {{\"home_price\", Int64.Type}, {\"home_price_label\", type text}, {\"closing_allowance_pct\", type number}, {\"closing_allowance_label\", type text}, {\"minimum_down_payment\", type number}, {\"closing_allowance\", type number}, {\"upfront_cash_scenario\", type number}, {\"rule_date\", type text}, {\"price_basis\", type text}, {\"scope\", type text}}, \"en-CA\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Minimum down payment",
            "expression": "IF(HASONEVALUE(PurchaseCases[home_price]), MAX(PurchaseCases[minimum_down_payment]))",
            "formatString": "\"CAD \"#,0;(\"CAD \"#,0)"
          },
          {
            "name": "Closing cost allowance",
            "expression": "IF(HASONEVALUE(PurchaseCases[home_price]) && HASONEVALUE(PurchaseCases[closing_allowance_pct]), MAX(PurchaseCases[closing_allowance]))",
            "formatString": "\"CAD \"#,0;(\"CAD \"#,0)"
          },
          {
            "name": "Upfront cash scenario",
            "expression": "IF(HASONEVALUE(PurchaseCases[home_price]) && HASONEVALUE(PurchaseCases[closing_allowance_pct]), MAX(PurchaseCases[upfront_cash_scenario]))",
            "formatString": "\"CAD \"#,0;(\"CAD \"#,0)"
          }
        ]
      }

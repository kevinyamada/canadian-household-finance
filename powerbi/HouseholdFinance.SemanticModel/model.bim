                "    Source = Table.FromRecords(Json.Document(Binary.FromText(\"\", BinaryEncoding.Base64))),",
                "    Typed = Table.TransformColumnTypes(Source, {{\"year\", Int64.Type}, {\"income\", type number}, {\"consumption\", type number}, {\"pension\", type number}, {\"saving\", type number}, {\"quarter_count\", Int64.Type}, {\"income_less_consumption\", type number}, {\"rounding_residual\", type number}}, \"en-CA\")",
                "in",

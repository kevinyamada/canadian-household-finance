{
  "name": "HouseholdFinance",
  "compatibilityLevel": 1600,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-CA",
    "tables": [
      {
        "name": "AuditSummary",
        "columns": [
          {
            "name": "latest_year",
            "dataType": "int64",
            "sourceColumn": "latest_year",
            "summarizeBy": "none"
          },
          {
            "name": "annual_income",
            "dataType": "double",
            "sourceColumn": "annual_income",
            "summarizeBy": "none"
          },
          {
            "name": "annual_consumption",
            "dataType": "double",
            "sourceColumn": "annual_consumption",
            "summarizeBy": "none"
          },
          {
            "name": "annual_income_less_consumption",
            "dataType": "double",
            "sourceColumn": "annual_income_less_consumption",
            "summarizeBy": "none"
          },
          {
            "name": "annual_pension",
            "dataType": "double",
            "sourceColumn": "annual_pension",
            "summarizeBy": "none"
          },
          {
            "name": "annual_net_saving",
            "dataType": "double",
            "sourceColumn": "annual_net_saving",
            "summarizeBy": "none"
          },
          {
            "name": "quarterly_net_saving",
            "dataType": "double",
            "sourceColumn": "quarterly_net_saving",
            "summarizeBy": "none"
          },
          {
            "name": "minimum_down_payment",
            "dataType": "double",
            "sourceColumn": "minimum_down_payment",
            "summarizeBy": "none",
            "formatString": "\"CAD \"#,0;(\"CAD \"#,0)"
          },
          {
            "name": "upfront_cash_scenario",
            "dataType": "double",
            "sourceColumn": "upfront_cash_scenario",
            "summarizeBy": "none",
            "formatString": "\"CAD \"#,0;(\"CAD \"#,0)"
          }
        ],
        "partitions": [
          {
            "name": "AuditSummary",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Table.FromRecords(Json.Document(Binary.FromText(\"\", BinaryEncoding.Base64))),",
                "    Typed = Table.TransformColumnTypes(Source, {{\"latest_year\", Int64.Type}, {\"annual_income\", type number}, {\"annual_consumption\", type number}, {\"annual_income_less_consumption\", type number}, {\"annual_pension\", type number}, {\"annual_net_saving\", type number}, {\"quarterly_net_saving\", type number}, {\"minimum_down_payment\", type number}, {\"upfront_cash_scenario\", type number}}, \"en-CA\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Annual reported saving",
            "expression": "MAX(AuditSummary[annual_net_saving])",
            "formatString": "\"CAD \"#,0;(\"CAD \"#,0)"
          },
          {
            "name": "Latest quarter saving",
            "expression": "MAX(AuditSummary[quarterly_net_saving])",
            "formatString": "\"CAD \"#,0;(\"CAD \"#,0)"
          },
          {
            "name": "Illustrative minimum down",
            "expression": "MAX(AuditSummary[minimum_down_payment])",
            "formatString": "\"CAD \"#,0;(\"CAD \"#,0)"
          }
        ]
      },

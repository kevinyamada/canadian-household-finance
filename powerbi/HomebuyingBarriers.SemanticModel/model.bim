ct\", type number}}, \"en-CA\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Cash target",
            "expression": "IF(HASONEVALUE('Cases'[case_id]), MAX('Cases'[cash_target]))",
            "formatString": "\"CAD \"#,0;(\"CAD \"#,0)"
          },
          {
            "name": "Available cash",
            "expression": "IF(HASONEVALUE('Cases'[case_id]), MAX('Cases'[profile_cash]))",
            "formatString": "\"CAD \"#,0;(\"CAD \"#,0)"
          },
          {
            "name": "Cash shortfall",
            "expression": "IF(HASONEVALUE('Cases'[case_id]), MAX('Cases'[cash_gap]))",
            "formatString": "\"CAD \"#,0;(\"CAD \"#,0)"
          },
          {
            "name": "Income needed",
            "expression": "IF(HASONEVALUE('Cases'[case_id]), MAX('Cases'[required_gross_income]))",
            "formatString": "\"CAD \"#,0;(\"CAD \"#,0)"
          },
          {
            "name": "Profile income",
            "expression": "IF(HASONEVALUE('Cases'[case_id]), MAX('Cases'[profile_income]))",
            "formatString": "\"CAD \"#,0;(\"CAD \"#,0)"
          },
          {
            "name": "Income shortfall",
            "expression": "IF(HASONEVALUE('Cases'[case_id]), MAX('Cases'[income_gap]))",
            "formatString": "\"CAD \"#,0;(\"CAD \"#,0)"
          },
          {
            "name": "Monthly outgoings",
            "expression": "IF(HASONEVALUE('Cases'[case_id]), MAX('Cases'[modeled_monthly_outgoings]))",
            "formatString": "\"CAD \"#,0;(\"CAD \"#,0)"
          },
          {
            "name": "Mortgage payment",
            "expression": "IF(HASONEVALUE('Cases'[case_id]), MAX('Cases'[monthly_mortgage]))",
            "formatString": "\"CAD \"#,0;(\"CAD \"#,0)"
          },
          {
            "name": "Selected result",
            "expression": "IF(HASONEVALUE('Cases'[case_id]), SELECTEDVALUE('Cases'[barrier]), \"Choose one city, buyer and scenario\")",
            "formatString": ""
          }
        ]
      },
